{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "lang": {
      "type": "string",
      "enum": [
        "en",
        "fr"
      ]
    },
    "register": {
      "type": "string",
      "enum": [
        "briefing-note",
        "client-reply",
        "meeting-summary"
      ]
    },
    "title": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "fr": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en",
        "fr"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "wordTarget": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "suggestedMinutes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "lang",
    "register",
    "title",
    "task",
    "wordTarget",
    "suggestedMinutes"
  ],
  "additionalProperties": false
}
