{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "skill": {
      "type": "string",
      "enum": [
        "reading",
        "writing"
      ]
    },
    "lang": {
      "type": "string",
      "enum": [
        "en",
        "fr"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "cloze",
        "comprehension",
        "error-id",
        "best-completion"
      ]
    },
    "passageId": {
      "type": "string",
      "minLength": 1
    },
    "stem": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "fr": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en",
        "fr"
      ],
      "additionalProperties": false
    },
    "blankIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "a",
              "b",
              "c",
              "d"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "fr": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "en",
              "fr"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "text",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "key": {
      "type": "string",
      "enum": [
        "a",
        "b",
        "c",
        "d"
      ]
    },
    "explanation": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "fr": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en",
        "fr"
      ],
      "additionalProperties": false
    },
    "subSkill": {
      "type": "string",
      "enum": [
        "main-idea",
        "specific-detail",
        "inference",
        "vocabulary-in-context",
        "cohesion-and-reference",
        "tone-and-intent",
        "text-structure",
        "numerical-and-tabular-detail",
        "verb-tense-and-mood",
        "agreement",
        "prepositions-and-government",
        "pronouns",
        "connectors-and-discourse-markers",
        "register-and-formality",
        "word-choice-precision",
        "false-friends-and-anglicisms",
        "punctuation-and-mechanics",
        "sentence-structure",
        "comprehension-of-complex-speech",
        "fluency-and-hesitation",
        "grammatical-accuracy-under-pressure",
        "vocabulary-range-and-precision",
        "discourse-organisation",
        "task-achievement",
        "pronunciation-and-intelligibility",
        "interaction-and-repair-strategies"
      ]
    },
    "targetBand": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "stats": {
      "type": "object",
      "properties": {
        "responses": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "proportionCorrect": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pointBiserial": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "responses",
        "proportionCorrect",
        "pointBiserial",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "topic": {
      "type": "string",
      "enum": [
        "human-resources",
        "finance-and-budgets",
        "it-and-digital",
        "service-delivery",
        "policy-and-legislation",
        "health-and-safety",
        "procurement",
        "communications",
        "project-management",
        "official-languages",
        "accessibility",
        "environment"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "authored",
            "generated",
            "adapted"
          ]
        },
        "sourcePassageId": {
          "type": "string",
          "minLength": 1
        },
        "generator": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "promptVersion": {
              "type": "string",
              "minLength": 1
            },
            "date": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            }
          },
          "required": [
            "model",
            "promptVersion",
            "date"
          ],
          "additionalProperties": false
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 1
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "contributor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 39,
          "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
        }
      },
      "required": [
        "origin"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "published",
        "retired"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "id",
    "version",
    "skill",
    "lang",
    "type",
    "stem",
    "options",
    "key",
    "explanation",
    "subSkill",
    "targetBand",
    "topic",
    "tags",
    "provenance",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
