{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "skill": {
      "type": "string",
      "enum": [
        "reading",
        "writing"
      ]
    },
    "lang": {
      "type": "string",
      "enum": [
        "en",
        "fr"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "supervised",
        "unsupervised"
      ]
    },
    "itemIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pilotItemIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "timeLimitMinutes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "bandCuts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "band": {
            "type": "string",
            "enum": [
              "X",
              "A",
              "B",
              "C",
              "E"
            ]
          },
          "min": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "max": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "band",
          "min",
          "max"
        ],
        "additionalProperties": false
      }
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "skill",
    "lang",
    "mode",
    "itemIds",
    "pilotItemIds",
    "timeLimitMinutes",
    "bandCuts",
    "version"
  ],
  "additionalProperties": false
}
