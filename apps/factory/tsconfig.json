{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.test-d.ts",
    "src/**/*.integration.test.ts",
    "src/**/__tests__/**"
  ],
  "references": [
    {
      "path": "../../packages/adapters"
    },
    {
      "path": "../../packages/domain"
    }
  ]
