{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm --filter @palier/web start --port 3200",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:3200/en",
        "http://localhost:3200/fr",
        "http://localhost:3200/en/start",
        "http://localhost:3200/en/home",
        "http://localhost:3200/fr/practice/reading",
        "http://localhost:3200/en/review",
        "http://localhost:3200/fr/progress",
        "http://localhost:3200/en/settings/data",
        "http://localhost:3200/fr/settings/sync",
        "http://localhost:3200/en/settings/key",
        "http://localhost:3200/fr/practice/writing/workshop",
        "http://localhost:3200/fr/practice/writing/generate",
        "http://localhost:3200/fr/practice/oral",
        "http://localhost:3200/fr/practice/oral/report",
        "http://localhost:3200/en/exam",
        "http://localhost:3200/fr/exam/run",
        "http://localhost:3200/en/exam/results"
      ],
      "numberOfRuns": 5,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "aggregationMethod": "median",
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
