{
  "name": "@palier/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/prepare-public.mjs && next dev",
    "build": "node scripts/prepare-public.mjs && next build",
    "db:migrate": "node scripts/db-migrate.mjs",
    "item-statistics": "node scripts/item-statistics.mjs",
    "billing-check": "node scripts/billing-check.mjs",
    "start": "next start",
    "check-types": "next typegen && tsc --noEmit",
    "bundle-size": "node scripts/check-bundle-size.mjs",
    "lighthouse": "lhci autorun",
    "clean": "rm -rf .next .lighthouseci *.tsbuildinfo public/content public/sw.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@palier/adapters": "workspace:*",
    "@palier/app": "workspace:*",
    "@palier/content": "workspace:*",
    "@palier/domain": "workspace:*",
    "@palier/engine": "workspace:*",
    "@palier/ui": "workspace:*",
    "drizzle-orm": "0.45.3",
    "next": "16.3.5",
    "next-intl": "4.14.5",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@palier/testing": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  }
}
