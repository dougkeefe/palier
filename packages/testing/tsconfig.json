{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"]
  },
  "include": [
    "src",
    "src/recorded/openai/*.json"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.test-d.ts",
    "src/**/*.integration.test.ts",
    "src/**/__tests__/**"
  ],
  "references": [
    {
      "path": "../app"
    },
    {
      "path": "../domain"
    }
  ]
}
