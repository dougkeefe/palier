{
  "name": "@palier/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./in-memory": {
      "types": "./dist/in-memory/index.d.ts",
      "default": "./dist/in-memory/index.js"
    },
    "./msw/browser": {
      "types": "./dist/msw/browser.d.ts",
      "default": "./dist/msw/browser.js"
    },
    "./setup": {
      "types": "./dist/setup/index.d.ts",
      "default": "./dist/setup/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "check-types": "tsc -p tsconfig.vitest.json --noEmit"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@palier/app": "workspace:*",
    "@palier/domain": "workspace:*",
    "fake-indexeddb": "6.2.5",
    "msw": "2.15.0"
  },
  "peerDependencies": {
    "vitest": "^5.0.0"
  }
}
