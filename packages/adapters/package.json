{
  "name": "@palier/adapters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ids": {
      "types": "./dist/ids/index.d.ts",
      "default": "./dist/ids/index.js"
    },
    "./dexie": {
      "types": "./dist/dexie/index.d.ts",
      "default": "./dist/dexie/index.js"
    },
    "./openai": {
      "types": "./dist/openai/index.d.ts",
      "default": "./dist/openai/index.js"
    },
    "./bank": {
      "types": "./dist/bank/index.d.ts",
      "default": "./dist/bank/index.js"
    },
    "./sync": {
      "types": "./dist/sync/index.d.ts",
      "default": "./dist/sync/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "default": "./dist/telemetry/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "check-types": "tsc -p tsconfig.vitest.json --noEmit"
  },
  "devDependencies": {
    "@palier/testing": "workspace:*",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@palier/app": "workspace:*",
    "@palier/domain": "workspace:*",
    "dexie": "4.4.6"
  }
}
