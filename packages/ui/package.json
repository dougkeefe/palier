{
  "name": "@palier/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/styles/tokens.css",
    "./components.css": "./dist/styles/components.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && mkdir -p dist/styles && cp src/styles/*.css dist/styles/",
    "clean": "rm -rf dist *.tsbuildinfo",
    "check-types": "tsc -p tsconfig.vitest.json --noEmit"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@palier/domain": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "26.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
