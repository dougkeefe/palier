{
  "name": "palier",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check-types": "turbo run check-types",
    "lint": "eslint --cache --max-warnings=0 .",
    "boundaries": "depcruise --config .dependency-cruiser.cjs --output-type err-long packages/*/src apps/factory/src && depcruise --config apps/web/.dependency-cruiser.cjs --output-type err-long apps/web/src",
    "test": "vitest run --coverage",
    "verify": "pnpm run check-types && pnpm run lint && pnpm run boundaries && pnpm run test",
    "clean": "turbo run clean && tsc -b --clean",
    "test:integration": "PALIER_INTEGRATION=1 vitest run --project=integration --project=integration-testing --project=integration-web",
    "test:e2e": "pnpm --filter @palier/web exec playwright test",
    "verify:medium": "pnpm run test:integration && pnpm run test:e2e",
    "mutation": "stryker run"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "dependency-cruiser": "18.4.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-boundaries": "7.2.0",
    "fast-check": "4.10.2",
    "turbo": "^2.11.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  },
  "packageManager": "pnpm@10.13.1"
}
